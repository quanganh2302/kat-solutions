# Add server-side integration variables only when an approved integration is implemented.

# Origin of the ASA demo deployment (its own Vercel project). Enables the
# /demo/asa multi-zone proxy in next.config.ts. Example:
# ASA_DEMO_ORIGIN="https://asa-demo.vercel.app"

# Origin of the TUITION demo deployment (music-center, its own Vercel project).
# Enables the /demo/tuition multi-zone proxy in next.config.ts. Example:
# TUITION_DEMO_ORIGIN="https://music-center.vercel.app"
